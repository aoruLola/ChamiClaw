# ChamiClaw Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.

# ============================================
# Runtime Profile
# ============================================
RUN_PROFILE=sim
EXECUTION_DRY_RUN=true
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
CHAMICLAW_LOAD_DOTENV=true

# ============================================
# Persistence
# ============================================
REPOSITORY_BACKEND=sqlite
SQLITE_PATH=data/chamiclaw_t1.db
PARAMS_PATH=data/strategy_params.json
DATA_RETENTION_DAYS=30

# ============================================
# Market / Weather Sources
# ============================================
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_REST_URL=https://clob.polymarket.com
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
NWS_BASE_URL=https://api.weather.gov
BRAVE_API_KEY=

# ============================================
# Weather Batch Strategy
# ============================================
WEATHER_ENABLED=true
WEATHER_ONLY_US_MARKETS=true
WEATHER_MARKET_TYPE=daily_precipitation
WEATHER_BATCH_MAX_CANDIDATES=12
WEATHER_BATCH_MAX_ORDERS=6
WEATHER_MARKET_REFRESH_MINUTES=360
WEATHER_INFO_REFRESH_MINUTES=360
WEATHER_STRATEGY_LOOP_MINUTES=720
WEATHER_MAX_POSITION_PER_MARKET_USD=50
WEATHER_MAX_BATCH_RISK_USD=200

# ============================================
# Execution / Simmer
# ============================================
SIMMER_BASE_URL=https://api.simmer.markets
SIMMER_API_KEY=your_simmer_api_key_here
EXECUTION_MAX_RETRIES=2
EXECUTION_RETRY_BACKOFF_SECONDS=0.5
EXECUTION_BREAKER_FAILURES=5
EXECUTION_BREAKER_COOLDOWN_SECONDS=60
EXECUTION_RATE_LIMIT_PER_MARKET_PER_MINUTE=3
EXECUTION_RATE_LIMIT_GLOBAL_PER_MINUTE=20

# ============================================
# Price Stream / WebSocket
# ============================================
CLOB_WS_MAX_RETRIES=10
CLOB_WS_BACKOFF_BASE_SECONDS=1.0
CLOB_WS_BACKOFF_MAX_SECONDS=30.0
WS_STALE_TIMEOUT_SECONDS=90
PRICE_FLUSH_SECONDS=30

# ============================================
# Phase Gate
# ============================================
PHASE_GATE_ENABLED=true
PHASE1_MIN_TRADES=200
PHASE1_MIN_WIN_RATE=0.57
PHASE1_MIN_RR=1.1
PHASE1_MAX_DRAWDOWN=0.05

# ============================================
# LLM Review (OpenAI-compatible)
# ============================================
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1
LLM_DECISION_TEMPERATURE=0
LLM_FAILSAFE_MODE=reject

# ============================================
# Generic Webhook Notifications
# ============================================
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://claw.alyra.cn/Claw
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=1
WEBHOOK_SERVICE_NAME=chamiclaw
WEBHOOK_ENVIRONMENT=prod
