# ChamiClaw Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# ============================================
# External API Credentials
# ============================================

# Simmer Execution API
SIMMER_API_KEY=your_simmer_api_key_here
SIMMER_AGENT_ID=your_simmer_agent_id_here
SIMMER_BASE_URL=https://api.simmer.markets

# Wallet Private Key (for signing transactions)
WALLET_PRIVATE_KEY=0x_your_private_key_here

# Brave Search API
BRAVE_API_KEY=your_brave_api_key_here

# ============================================
# Execution Mode
# ============================================

# Set to 'false' for live trading, 'true' for simulation
EXECUTION_DRY_RUN=true
RUN_PROFILE=sim

# ============================================
# Scheduler Configuration
# ============================================

SCHEDULER_ENABLED=false
MARKET_REFRESH_MINUTES=5
PRICE_AGGREGATE_SECONDS=30
STRATEGY_LOOP_MINUTES=3
INFO_REFRESH_MINUTES=10

# ============================================
# Repository Configuration
# ============================================

REPOSITORY_BACKEND=sqlite
SQLITE_PATH=data/chamiclaw_t1.db
PARAMS_PATH=data/strategy_params.json
DATA_RETENTION_DAYS=30

# ============================================
# External API Endpoints
# ============================================

GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_WS_URL=wss://clob.polymarket.com/ws
CLOB_REST_URL=https://clob.polymarket.com

# ============================================
# WebSocket Configuration
# ============================================

CLOB_WS_MAX_RETRIES=10
CLOB_WS_BACKOFF_BASE_SECONDS=1.0
CLOB_WS_BACKOFF_MAX_SECONDS=30.0
WS_STALE_TIMEOUT_SECONDS=90
PRICE_FLUSH_SECONDS=30

# ============================================
# Phase Gate Configuration
# ============================================

PHASE_GATE_ENABLED=true
PHASE1_MIN_TRADES=200
PHASE1_MIN_WIN_RATE=0.57
PHASE1_MIN_RR=1.1
PHASE1_MAX_DRAWDOWN=0.05

# ============================================
# Logging
# ============================================

LOG_LEVEL=INFO
