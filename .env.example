# API / network
RPC_URL=
POLYMARKET_PRIVATE_KEY=
DISCORD_WEBHOOK_URL=

# Optional mock mode
LLM_MODE=mock
CHAMICLAW_LLM_MODE=mock
CHAMICLAW_LLM1_ENDPOINT=
CHAMICLAW_LLM2_ENDPOINT=
CHAMICLAW_LLM_API_KEY=
CHAMICLAW_CALIBRATION_METHOD=isotonic
CHAMICLAW_ORDERBOOK_PATH_TEMPLATE=/book?market={market_id}
CHAMICLAW_ORDERBOOK_TIMEOUT_SEC=6
CHAMICLAW_ENABLE_ORDERBOOK=true
CHAMICLAW_ORDERBOOK_TRADABLE_ONLY=true
CHAMICLAW_MAX_ORDERBOOK_CALLS_PER_CYCLE=40
CHAMICLAW_MAX_CYCLE_RUNTIME_SEC=120
CHAMICLAW_CLOB_SUBMIT_ENDPOINT=/orders
CHAMICLAW_CLOB_STATUS_ENDPOINT=/orders/{order_id}
CHAMICLAW_CLOB_CANCEL_ENDPOINT=/orders/{order_id}/cancel
CHAMICLAW_CLOB_ORDERBOOK_ENDPOINT=/book?market={market_id}
CHAMICLAW_CLOB_POSITIONS_ENDPOINT=/positions
CHAMICLAW_CLOB_PROFILE=default

# Runtime role boundary (default: research)
# research: analytics/scanning only, cannot read private key
# execution: order execution allowed, private key visible
CHAMICLAW_ROLE=research

# SQLite path (optional override)
CHAMICLAW_DB_PATH=data/chamiclaw.db
CHAMICLAW_ACCOUNT_EQUITY_USD=10000
CHAMICLAW_RECON_ENDPOINT=
CHAMICLAW_RECON_QTY_TOLERANCE=0.0001
CHAMICLAW_STRUCTURAL_CONFLICT_GAP_BPS=80
CHAMICLAW_DISCORD_WEBHOOK=
